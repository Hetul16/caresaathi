# Copy to .env.production on the server and fill in. Never commit it. Names and shapes only here.
# The database host is "db" (the compose service), not 127.0.0.1.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=caresaathi
DATABASE_URL_ADMIN=postgresql+psycopg://postgres:<POSTGRES_PASSWORD>@db:5432/caresaathi
DATABASE_URL_APP=postgresql+psycopg://caresaathi_app:<app role password>@db:5432/caresaathi
DATABASE_URL_AUTH=postgresql+psycopg://caresaathi_auth:<auth role password>@db:5432/caresaathi
DATABASE_URL_WORKER=postgresql+psycopg://caresaathi_worker:<worker role password>@db:5432/caresaathi

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/srv/.storage
# MinIO is not needed with local storage, but compose validates these two names:
S3_ACCESS_KEY=unused
S3_SECRET_KEY=unused-unused

MODEL_MODE=live
META_API_BASE=https://api.meta.ai/v1
META_API_KEY=
META_SPARK_MODEL=muse-spark-1.3
META_SPARK_DEV_MODEL=muse-spark-1.3-contributor
META_ASR_MODEL=muse-voice-transcribe-1.0
ALLOW_CONTRIBUTOR_MODELS=true
SPEND_LIMIT_USD=3.50

JWT_SECRET=
TOKEN_PEPPER=
# The public address people will open, with https://
PUBLIC_BASE_URL=
SITE_ADDRESS=
# Private deployment (D-69): set it to keep the address unreachable, clear it to go public. See PUBLIC_LAUNCH.md.
SITE_GATE_TOKEN=
ALLOW_DEMO_SEED=true
