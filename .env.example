# Copy to .env and fill in. Never commit .env. Names only here, no real values.

# --- Postgres (docker compose creates the database; the roles come from db/roles_and_grants.sql) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=caresaathi
# One connection string per role. Change the role passwords in roles_and_grants.sql first.
DATABASE_URL_APP=postgresql://caresaathi_app:CHANGE_ME@db:5432/caresaathi
DATABASE_URL_AUTH=postgresql://caresaathi_auth:CHANGE_ME@db:5432/caresaathi
DATABASE_URL_WORKER=postgresql://caresaathi_worker:CHANGE_ME@db:5432/caresaathi

# --- Object storage (MinIO locally, any S3-compatible service in production) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=caresaathi

# --- Meta Model API ---
META_API_BASE=https://api.meta.ai/v1
META_API_KEY=
META_SPARK_MODEL=muse-spark-1.3
# Contributor variant: Meta may train on prompts. Synthetic data only.
META_SPARK_DEV_MODEL=muse-spark-1.3-contributor
META_ASR_MODEL=muse-voice-transcribe-1.0
ALLOW_CONTRIBUTOR_MODELS=true

# --- Text to speech (provider chosen after the Marathi and Hindi voice test) ---
TTS_PROVIDER=
TTS_API_KEY=

# --- WhatsApp Cloud API (optional) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- App secrets ---
JWT_SECRET=
TOKEN_PEPPER=
PUBLIC_BASE_URL=https://localhost

# --- Private deployment (D-69) ---
# While this is set, the API answers 404 to any request without the matching X-Site-Gate header, and the website adds it
# server-side. Empty means the API answers anyone. See PUBLIC_LAUNCH.md.
SITE_GATE_TOKEN=

# --- Safety switches ---
# true blocks allergy checks for non-synthetic patients while any drug family used is unreviewed
REFERENCE_LIST_REQUIRE_REVIEW=true
