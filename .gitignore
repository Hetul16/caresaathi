*.pyc
node_modules/
.next/
dist/
.venv/
.pytest_cache/
.DS_Store

# local dev object storage
.storage/

# live-model runs and rendered documents (regenerate with data/synthetic/render.py)
data/live_runs/
data/synthetic/rendered/
demo_uploads/

# Word leaves a lock file beside any open .docx; it must never reach a public repo
~$*
