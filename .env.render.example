# The shapes of the values for the free split deployment (docs/19-deployment.md, way D). Nothing here is secret; nothing here is
# committed with a real value. Names come from render.yaml; this file is only to show what each one looks like.
#
# Neon. Copy the pooled connection string, then swap the role and password per line. Keep ?sslmode=require.
DATABASE_URL_ADMIN=postgresql+psycopg://neondb_owner:<owner password>@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/caresaathi?sslmode=require
DATABASE_URL_APP=postgresql+psycopg://caresaathi_app:<app password>@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/caresaathi?sslmode=require
DATABASE_URL_AUTH=postgresql+psycopg://caresaathi_auth:<auth password>@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/caresaathi?sslmode=require
DATABASE_URL_WORKER=postgresql+psycopg://caresaathi_worker:<worker password>@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/caresaathi?sslmode=require

# Cloudflare R2. The endpoint is the S3 API address of the bucket's account, without the bucket name.
STORAGE_BACKEND=s3
S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
S3_BUCKET=caresaathi
S3_ACCESS_KEY=<R2 access key id>
S3_SECRET_KEY=<R2 secret access key>

# The address people open: the website, not the API. Emergency card and doctor links are built from it.
PUBLIC_BASE_URL=https://caresaathi.vercel.app
CORS_ORIGINS=https://caresaathi.vercel.app

# Private until submission day (D-69). Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Put the SAME value in Render and in Vercel. Clearing it in both places is what makes the site public.
SITE_GATE_TOKEN=<32 random characters>

# Vercel needs exactly two, both server-side (never NEXT_PUBLIC_*):
#   BACKEND_URL=https://caresaathi-api.onrender.com
#   SITE_GATE_TOKEN=<the same value as above>
