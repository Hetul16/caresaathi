  users {
    uuid id PK
    citext email
    text phone_e164
    pref_lang preferred_language
  }
  patients {
    uuid id PK
    text full_name
    date date_of_birth
    pref_lang preferred_language
    bool is_synthetic
  }
  family_members {
    uuid id PK
    uuid patient_id FK
    uuid user_id FK
    member_role member_role
    invite_status status
    bool can_approve
  }
  devices {
    uuid id PK
    uuid patient_id FK
    bytea token_hash
    uuid approved_by_member_id FK
  }
  documents {
    uuid id PK
    uuid patient_id FK
    doc_type doc_type
    bytea sha256
    text storage_key
    doc_status status
  }
  consents {
    uuid id PK
    consent_type consent_type
    speaker_role subject_role
    text given_by_name
    timestamptz revoked_at
  }
  visits {
    uuid id PK
    uuid patient_consent_id FK
    uuid doctor_consent_id FK
    visit_status status
    bool delete_audio_after_transcription
  }
  transcript_segments {
    uuid id PK
    uuid visit_id FK
    text speaker_label
    speaker_role mapped_role
    int start_ms
    text body
  }
  visit_speakers {
    uuid id PK
    uuid visit_id FK
    text speaker_label
    speaker_role role
  }
  source_refs {
    uuid id PK
    source_kind kind
    uuid document_id FK
    int page
    uuid segment_id FK
    text quote
  }
  messages {
    uuid id PK
    uuid conversation_id FK
    media_kind media
    text transcript
  }
